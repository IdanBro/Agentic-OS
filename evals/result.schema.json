{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-os.local/evals/result.schema.json",
  "title": "Methodology OS Eval Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "authority",
    "human_gate",
    "risk",
    "review_required",
    "integration_allowed",
    "verification",
    "model_family",
    "effort",
    "skills",
    "learning_class",
    "candidate_status",
    "actions",
    "policy_basis",
    "user_message"
  ],
  "properties": {
    "scenario_id": {"type": "string", "pattern": "^E-[0-9]{3}$"},
    "authority": {"type": ["string", "null"], "enum": ["A0", "A1", "A2", "A3", null]},
    "human_gate": {"type": ["string", "null"], "enum": ["not_applicable", "not_required", "required", "satisfied", "blocked", null]},
    "risk": {"type": ["string", "null"], "enum": ["low", "medium", "high", null]},
    "review_required": {"type": ["boolean", "null"]},
    "integration_allowed": {"type": ["boolean", "null"]},
    "verification": {"type": ["string", "null"], "enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_RUN", "N/A", null]},
    "model_family": {"type": ["string", "null"], "enum": ["haiku", "sonnet", "opus", "fable", "inherit", null]},
    "effort": {"type": ["string", "null"], "enum": ["low", "medium", "high", "xhigh", "max", "inherit", null]},
    "skills": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "learning_class": {"type": ["string", "null"], "enum": ["project_specific", "global_candidate", "noise", "promoted", null]},
    "candidate_status": {"type": ["string", "null"], "enum": ["OBSERVATION", "CANDIDATE", "NEEDS_EVIDENCE", "VALIDATING", "READY_FOR_PROMOTION", "APPROVED", "PROMOTED", "REJECTED", "DEFERRED", "SUPERSEDED", null]},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 2}
    },
    "verification_plan": {
      "type": "array",
      "items": {"type": "string"}
    },
    "policy_basis": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 3},
      "description": "Concise policy references/reasons only. Do not provide hidden chain-of-thought."
    },
    "user_message": {
      "type": ["string", "null"],
      "description": "What the PM would tell/ask the user, or null when no user interruption is appropriate."
    }
  }
}
